// Pathfinder Sheet Manager — data model
//
// Covers Pathfinder 1e and Spheres of Power characters. Library tables
// (GameClass, Feat, Spell, Sphere, Talent, Item, Skill) hold shared rules
// content; the seed adds a handful and `scripts/import-foundry.ts` bulk-loads
// the rest from the Foundry VTT `pf1` system + Spheres module datasets.
//
// `data Json?` bags exist deliberately so the app can evolve system-specific
// fields during early development without a migration for every tweak.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RulesSystem {
  PATHFINDER_1E
  SPHERES_OF_POWER
}

enum UserRole {
  USER
  ADMIN
}

enum Ability {
  STR
  DEX
  CON
  INT
  WIS
  CHA
}

enum CreatureSize {
  FINE
  DIMINUTIVE
  TINY
  SMALL
  MEDIUM
  LARGE
  HUGE
  GARGANTUAN
  COLOSSAL
}

enum Progression {
  GOOD
  POOR
}

enum BabProgression {
  FULL
  THREE_QUARTER
  HALF
}

enum ItemType {
  WEAPON
  ARMOR
  SHIELD
  GEAR
  CONSUMABLE
  TOOL
  WONDROUS
  RING
  ROD
  STAFF
  WAND
  POTION
  SCROLL
  AMMUNITION
  TREASURE
  OTHER
}

enum WeaponCategory {
  SIMPLE
  MARTIAL
  EXOTIC
  NATURAL
}

enum ArmorCategory {
  NONE
  LIGHT
  MEDIUM
  HEAVY
}

enum SphereType {
  MAGIC
  MIGHT
  GUILE
}

enum RollKind {
  ATTACK
  DAMAGE
  SAVE
  SKILL
  ABILITY_CHECK
  INITIATIVE
  CONCENTRATION
  CUSTOM
}

enum TraditionKind {
  CASTING
  MARTIAL
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth) — database session strategy via @auth/prisma-adapter
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  characters Character[]
  rollLogs   RollLog[]

  // Library content this user authored.
  items    Item[]
  feats    Feat[]
  spells   Spell[]
  spheres  Sphere[]
  talents  Talent[]
  classes  GameClass[]
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Characters
// ---------------------------------------------------------------------------

model Character {
  id     String @id @default(cuid())
  userId String

  name     String
  system   RulesSystem
  race     String      @default("")
  alignment String     @default("")
  deity    String      @default("")
  size     CreatureSize @default(MEDIUM)
  gender   String      @default("")
  age      Int?
  notes    String      @default("")

  xp        Int @default(0)
  baseSpeed Int @default(30)

  // Base (pre-modifier) ability scores. Racial / enhancement / inherent
  // adjustments live in `abilityModifiers` and are applied by the derived-stat
  // calculator, never written back here.
  strength     Int @default(10)
  dexterity    Int @default(10)
  constitution Int @default(10)
  intelligence Int @default(10)
  wisdom       Int @default(10)
  charisma     Int @default(10)

  // { "enhancement": { "STR": 2 }, "inherent": { "CON": 1 }, ... }
  abilityModifiers Json @default("{}")

  // Hit points.
  maxHp     Int @default(0)
  currentHp Int @default(0)
  tempHp    Int @default(0)
  nonlethal Int @default(0)
  hpRolls   Json @default("[]") // per-level hit die rolls: number[]

  // Misc typed modifiers the calculator folds in, e.g.
  // { "ac": { "natural": 1, "deflection": 1 }, "saves": { "fort": 1 }, "initiative": 2 }
  modifiers Json @default("{}")

  // Freeform (e.g. "10/magic") — DR bypass types vary too much to compute,
  // so this is entered by hand rather than derived.
  damageReduction String @default("")

  // Spheres of Power casting pool (null for straight PF1e characters).
  spellPoints    Int?
  maxSpellPoints Int?
  // The ability governing this character's casting (Int/Wis/Cha per the
  // Spheres of Power rules) — chosen at creation, null for non-casters or
  // characters made before this was tracked (spell points then fell back
  // to the best of the three).
  castingAbility Ability?

  // Spheres of Might: grants bonuses to combat talents while active — a
  // per-combat state the player tracks by hand, not something derivable.
  martialFocus Boolean @default(false)

  // Discord delivery target for this character's rolls.
  discordWebhookUrl   String?
  discordWebhookLabel String?

  // Flexible bag for system-specific state during early development.
  data Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  classes    CharacterClass[]
  skillRanks CharacterSkillRank[]
  feats      CharacterFeat[]
  spells     CharacterSpell[]
  spheres    CharacterSphere[]
  talents    CharacterTalent[]
  inventory  InventoryItem[]
  rollLogs   RollLog[]
  actions    CharacterAction[]

  @@index([userId])
}

model CharacterClass {
  id          String  @id @default(cuid())
  characterId String
  gameClassId String?

  name              String
  levels            Int     @default(1)
  archetype         String  @default("")
  isFavoredClass    Boolean @default(false)
  hitDie            Int     @default(8)
  skillRanksPerLevel Int    @default(2)
  babProgression    BabProgression @default(THREE_QUARTER)
  fortProgression   Progression    @default(POOR)
  refProgression    Progression    @default(POOR)
  willProgression   Progression    @default(POOR)

  data Json @default("{}")

  character Character  @relation(fields: [characterId], references: [id], onDelete: Cascade)
  gameClass GameClass? @relation(fields: [gameClassId], references: [id])

  @@index([characterId])
}

model CharacterSkillRank {
  id          String @id @default(cuid())
  characterId String
  skillId     String

  ranks      Int     @default(0)
  isClassSkill Boolean @default(false)
  miscMod    Int     @default(0)
  notes      String  @default("")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  skill     Skill     @relation(fields: [skillId], references: [id])

  @@unique([characterId, skillId])
  @@index([characterId])
}

model CharacterFeat {
  id          String  @id @default(cuid())
  characterId String
  featId      String?

  name         String
  takenAtLevel Int     @default(1)
  notes        String  @default("")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  feat      Feat?     @relation(fields: [featId], references: [id])

  @@index([characterId])
}

model CharacterSpell {
  id          String  @id @default(cuid())
  characterId String
  spellId     String?

  name     String
  level    Int     @default(0)
  known    Boolean @default(true)
  prepared Int     @default(0)
  notes    String  @default("")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  spell     Spell?    @relation(fields: [spellId], references: [id])

  @@index([characterId])
}

model CharacterSphere {
  id          String  @id @default(cuid())
  characterId String
  sphereId    String?

  name  String
  notes String  @default("")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  sphere    Sphere?   @relation(fields: [sphereId], references: [id])

  @@index([characterId])
}

model CharacterTalent {
  id          String  @id @default(cuid())
  characterId String
  talentId    String?

  name       String
  sphereName String  @default("")
  notes      String  @default("")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  talent    Talent?   @relation(fields: [talentId], references: [id])

  @@index([characterId])
}

enum ActionSpeed {
  FREE
  SWIFT
  IMMEDIATE
  MOVE
  STANDARD
  FULL_ROUND
}

/** A player-defined custom action for the Combat tab's Actions section —
 * e.g. a class feature or improvised maneuver not covered by a weapon
 * attack or the standard combat maneuvers. Up to two roll slots (each a
 * dice expression + flat modifier) cover the common "attack roll + damage
 * roll" shape without hard-coding that pairing. */
model CharacterAction {
  id          String      @id @default(cuid())
  characterId String

  name        String
  description String      @default("")
  actionSpeed ActionSpeed @default(STANDARD)
  range       String      @default("")

  // { label, diceSides, diceCount, scalePerLevels, scaleSource, modifiers:
  // [{ label, value }] } — see src/lib/dice/action-roll.ts. scaleSource ""
  // means total character level; otherwise a CharacterClass.name, so e.g.
  // "1d6 per Destruction caster level" is diceSides:6, diceCount:0,
  // scalePerLevels:1, scaleSource:"<spellcasting class>".
  roll1 Json @default("{}")
  roll2 Json @default("{}")

  // CharacterFeat.id / CharacterTalent.id of feats/talents the player has
  // flagged as modifying this action — display-only cross-references, not
  // a computed bonus source.
  linkedFeatIds   String[] @default([])
  linkedTalentIds String[] @default([])

  // Empty for a player-authored custom action. Set to the granting
  // Sphere.name (e.g. "Destruction") for an action auto-created when that
  // sphere was taken — the sheet renders a sphere-specific card for these
  // instead of the generic roll-button UI, reading `sphereConfig` for its
  // player-chosen options (e.g. Destructive Blast's blast shape/type
  // talent picks). Shape of `sphereConfig` varies per sphere ability.
  sphereName   String @default("")
  sphereConfig Json   @default("{}")

  createdAt DateTime @default(now())

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId])
}

model InventoryItem {
  id          String  @id @default(cuid())
  characterId String
  itemId      String?

  name       String
  quantity   Int     @default(1)
  weight     Float   @default(0)
  costCp     Int     @default(0)
  equipped   Boolean @default(false)
  // Masterwork quality: -1 armor check penalty (armor/shields), +1 to attack (weapons).
  masterwork Boolean @default(false)
  slot       String  @default("")
  notes      String  @default("")

  // Snapshot / overrides for custom or edited items so the sheet is stable
  // even if the library entry later changes.
  customData Json @default("{}")
  // Attached enchantments/enhancements/attachments: [{ id, name, description }]
  effects Json @default("[]")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  item      Item?     @relation(fields: [itemId], references: [id])

  @@index([characterId])
}

// ---------------------------------------------------------------------------
// Library / catalog content
// ---------------------------------------------------------------------------

model GameClass {
  id     String      @id @default(cuid())
  system RulesSystem @default(PATHFINDER_1E)

  name               String
  hitDie             Int            @default(8)
  babProgression     BabProgression @default(THREE_QUARTER)
  fortProgression    Progression    @default(POOR)
  refProgression     Progression    @default(POOR)
  willProgression    Progression    @default(POOR)
  skillRanksPerLevel Int            @default(2)
  classSkills        String[]       @default([])
  description        String         @default("")

  source      String  @default("")
  isSrd       Boolean @default(false)
  createdById String?

  data Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy       User?            @relation(fields: [createdById], references: [id])
  features        ClassFeature[]
  characterClasses CharacterClass[]

  @@unique([system, name, source])
  @@index([name])
}

model ClassFeature {
  id      String @id @default(cuid())
  classId String

  name        String
  level       Int    @default(1)
  description String @default("")
  data        Json   @default("{}")

  gameClass GameClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
}

model Skill {
  id     String      @id @default(cuid())
  system RulesSystem @default(PATHFINDER_1E)

  name              String
  keyAbility        Ability
  trainedOnly       Boolean @default(false)
  armorCheckPenalty Boolean @default(false)
  description       String  @default("")

  source String  @default("")
  isSrd  Boolean @default(false)

  characterRanks CharacterSkillRank[]

  @@unique([system, name])
  @@index([name])
}

model Feat {
  id String @id @default(cuid())

  name          String
  featTypes     String[] @default([]) // e.g. ["Combat", "Metamagic"]
  /** Magic sphere(s) this feat is tied to (e.g. ["Destruction"]), when
   * scraped from a sphere's own "Sphere Feats" list — distinct from
   * featTypes, which holds the PF1e/SoP category tags (Combat, Racial,
   * Drawback, …). A feat can genuinely require, or offer a choice of,
   * more than one sphere (e.g. "Death or Fate sphere"), hence an array
   * rather than a single value. */
  sphereNames   String[] @default([])
  prerequisites String   @default("")
  benefit       String   @default("")
  description   String   @default("")
  /** Deep link to this feat's entry on the source wiki page, e.g.
   * "http://spheresofpower.wikidot.com/combat-feats#toc12" — points at the
   * page's own heading anchor when the source has one. */
  sourceUrl     String   @default("")

  source      String  @default("")
  isSrd       Boolean @default(false)
  createdById String?

  data Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy      User?           @relation(fields: [createdById], references: [id])
  characterFeats CharacterFeat[]

  @@unique([name, source])
  @@index([name])
}

model Spell {
  id String @id @default(cuid())

  name         String
  school       String  @default("")
  subschool    String  @default("")
  descriptors  String[] @default([])
  levels       Json     @default("{}") // { "wizard": 3, "cleric": 4 }
  castingTime  String   @default("")
  components   String   @default("")
  range        String   @default("")
  area         String   @default("")
  duration     String   @default("")
  savingThrow  String   @default("")
  spellResistance String @default("")
  description  String   @default("")

  source      String  @default("")
  isSrd       Boolean @default(false)
  createdById String?

  data Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy       User?            @relation(fields: [createdById], references: [id])
  characterSpells CharacterSpell[]

  @@unique([name, source])
  @@index([name])
}

model Sphere {
  id   String     @id @default(cuid())
  type SphereType @default(MAGIC)

  name        String
  description String @default("")

  source      String  @default("")
  isSrd       Boolean @default(false)
  createdById String?

  data Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy        User?             @relation(fields: [createdById], references: [id])
  talents          Talent[]
  characterSpheres CharacterSphere[]

  @@unique([name, source])
  @@index([name])
}

model Talent {
  id       String  @id @default(cuid())
  sphereId String?

  name          String
  sphereName    String   @default("")
  talentTypes   String[] @default([])
  prerequisites String   @default("")
  description   String   @default("")
  /** Deep link to this talent's entry on the source wiki page — see
   * Feat.sourceUrl. */
  sourceUrl     String   @default("")

  source      String  @default("")
  isSrd       Boolean @default(false)
  createdById String?

  data Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy        User?             @relation(fields: [createdById], references: [id])
  sphere           Sphere?           @relation(fields: [sphereId], references: [id])
  characterTalents CharacterTalent[]

  @@unique([name, source])
  @@index([name])
}

// ---------------------------------------------------------------------------
// Casting / martial tradition building blocks (see src/lib/rules/casting-tradition.ts)
// ---------------------------------------------------------------------------

model TraditionDrawback {
  id   String        @id @default(cuid())
  kind TraditionKind

  name        String
  description String @default("")
  /// Combat sphere name — only set for MARTIAL (sphere-specific) drawbacks.
  sphereName  String @default("")
  /// Usually 1; some general drawbacks "count as 2" toward the boon/spell-point economy.
  costInDrawbacks  Int      @default(1)
  prerequisites    String[] @default([])
  incompatibleWith String[] @default([])

  source String  @default("")
  isSrd  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, name, sphereName])
  @@index([kind])
}

model TraditionBoon {
  id   String @id @default(cuid())
  name String @unique

  description     String   @default("")
  costInDrawbacks Int      @default(2)
  prerequisites   String[] @default([])
  repeatable      Boolean  @default(false)
  /// Best-effort parsed mechanical grants: [{ type: "sphere"|"talent"|"feat", name }]
  grants Json @default("[]")

  source String  @default("")
  isSrd  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Item {
  id     String      @id @default(cuid())
  system RulesSystem @default(PATHFINDER_1E)

  name        String
  type        ItemType @default(GEAR)
  description String   @default("")
  costCp      Int      @default(0)
  weight      Float    @default(0)

  // Weapon fields (null for non-weapons).
  weaponCategory  WeaponCategory?
  damage          String?
  damageType      String?
  critRange       Int?            @default(20)
  critMultiplier  Int?            @default(2)
  rangeIncrement  Int?

  // Armor / shield fields (null for non-armor).
  armorCategory   ArmorCategory?
  acBonus         Int?
  maxDexBonus     Int?
  armorCheckPenalty Int?
  spellFailure    Int?

  source      String  @default("")
  isSrd       Boolean @default(false)
  createdById String?

  data Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy     User?           @relation(fields: [createdById], references: [id])
  inventoryRefs InventoryItem[]

  @@unique([system, name, source])
  @@index([name])
  @@index([type])
}

// ---------------------------------------------------------------------------
// Roll history
// ---------------------------------------------------------------------------

model RollLog {
  id          String  @id @default(cuid())
  characterId String
  userId      String

  kind       RollKind
  label      String
  expression String
  total      Int
  breakdown  Json     @default("{}") // { modifiers: [{ source, value }], ... }
  dice       Json     @default("[]") // per-die results

  discordDelivered Boolean @default(false)
  discordError     String?

  createdAt DateTime @default(now())

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([characterId, createdAt])
}
