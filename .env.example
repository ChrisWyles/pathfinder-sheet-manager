# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
#
# If you use the Neon CLI ("neon deploy" with neon.ts), it writes provisioned
# connection strings to `.env.local` instead — as DATABASE_URL and
# DATABASE_URL_UNPOOLED. Both this project's app and its Prisma tooling read
# `.env.local` first, then `.env`. You still need the AUTH_* values below in one
# of those files.
# ---------------------------------------------------------------------------

# Neon Postgres connection strings.
# Neon dashboard -> your project -> Connection Details.
# Use the pooled (`-pooler`) host for the app; the direct host for migrations.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# One of DIRECT_URL / DATABASE_URL_UNPOOLED (unpooled) is used by `prisma migrate`.
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js (NextAuth v5).
# Generate a secret with:  npx auth secret   (or)   openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Discord OAuth application.
# https://discord.com/developers/applications -> New Application -> OAuth2
# Redirect URL (dev):  http://localhost:3000/api/auth/callback/discord
AUTH_DISCORD_ID="your-discord-client-id"
AUTH_DISCORD_SECRET="your-discord-client-secret"

# Public base URL of the app. Used for OAuth callbacks and absolute links.
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
